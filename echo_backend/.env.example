# Local SQLite database for easiest setup.
DATABASE_URL=sqlite+aiosqlite:///./echoai-local.db

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend and aimodel run in the same runtime boundary.
# Real analysis requires a Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional explicit local/test fallback.
# Set true when you want local stub analysis instead of Gemini.
ALLOW_STUB_AI=false

# Small bounded parallelism for transcript chunk extraction.
GEMINI_CHUNK_CONCURRENCY=2

# Recycle long-lived DB connections periodically.
DB_POOL_RECYCLE_SECONDS=1800

# Local-only convenience fallback for the async upload jobs table.
# Keep false in normal environments and prefer Alembic migrations.
AUTO_CREATE_UPLOAD_JOBS_TABLE=false

# Firebase service account as base64-encoded JSON.
# Generate with: base64 -i firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=
