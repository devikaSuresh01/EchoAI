# Hosted PostgreSQL connection string.
# For Supabase on Render, prefer the Session pooler / pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-app.onrender.com

# Backend and aimodel run in the same runtime boundary.
# Real analysis requires a Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional explicit local/test fallback.
# Leave unset or false in normal runtime so missing Gemini config fails clearly.
ALLOW_STUB_AI=false

# Firebase service account as base64-encoded JSON.
# Generate with: base64 -i firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=
